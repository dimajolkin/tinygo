{
  "mcpServers": {
    "qdrant": {
      "command": "docker",
      "args": [
        "run",
        "-p",
        "8000:8000",
        "-e",
        "QDRANT_URL",
        "-e",
        "QDRANT_API_KEY",
        "-e",
        "COLLECTION_NAME",
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "QDRANT_API_KEY": "111",
        "COLLECTION_NAME": "tinigo"
      }
    }
  }
}